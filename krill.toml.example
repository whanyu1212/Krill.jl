# krill.toml — copy this to krill.toml and fill in your tokens/keys.
# Secrets can be inlined here or referenced as $ENV_VAR (expanded at startup).
# krill.toml should NOT be committed to git — add it to .gitignore.

# ---------------------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------------------

[provider]
name    = "openai"              # "openai" or "gemini"
model   = "gpt-4o-mini"        # model name for the chosen provider
api_key = "$OPENAI_API_KEY"    # or set OPENAI_API_KEY in .env

# [provider]
# name    = "gemini"
# model   = "gemini-2.0-flash"
# api_key = "$GEMINI_API_KEY"

# ---------------------------------------------------------------------------
# Channels — set enabled = true for each channel you want to run.
# All enabled channels are started from a single process.
# ---------------------------------------------------------------------------

[telegram]
enabled    = true
bot_token  = "$TELEGRAM_BOT_TOKEN"
allow_from = ["*"]             # Telegram user IDs; "*" allows everyone

[discord]
enabled    = false
bot_token  = "$DISCORD_BOT_TOKEN"
allow_from = ["*"]             # Discord user snowflakes; "*" allows everyone

# ---------------------------------------------------------------------------
# Runtime paths
# ---------------------------------------------------------------------------

[llm]
workspace                    = "context"  # agent file sandbox (committed to git)
data_dir                     = "/data"    # GCS bucket mount point; defaults to ~/.krill if empty
builtin_restrict_to_workspace = true      # prevent file tools from escaping workspace

# ---------------------------------------------------------------------------
# Profile — agent identity, tool toggles, MCP servers
# ---------------------------------------------------------------------------

[profile]
system_prompt = "You are a helpful assistant. Be concise and friendly."

[profile.tools]
provider_builtins    = true    # provider web search + code interpreter
local_builtins       = true    # file, web_fetch, web_search, github, message
builtin_skills       = true    # load skills from context/skills/
memory               = true    # per-session persistent memory
memory_consolidation = true    # auto-compact memory after each turn
cron                 = true    # cron_add / cron_list / cron_remove tools
subagents            = true    # spawn_subagent tool
exec                 = false   # shell exec (opt-in)
claude_code          = false   # delegate to Claude Code CLI (opt-in)
claude_code_model    = "sonnet"
codex                = false   # delegate to Codex CLI (opt-in)
codex_model          = ""      # leave empty for Codex default
history_summarization = false  # LLM-driven context window compression

# ---------------------------------------------------------------------------
# MCP servers (optional — add as many [[profile.mcp]] blocks as needed)
# ---------------------------------------------------------------------------

# [[profile.mcp]]
# name      = "filesystem"
# transport = "stdio"
# command   = "npx"
# args      = ["-y", "@modelcontextprotocol/server-filesystem", "context"]

# [[profile.mcp]]
